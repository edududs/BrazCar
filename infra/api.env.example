# Copy to ~/.brazcar/api.env on the host (chmod 600). Never versioned with real values.

DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=api-brazcar.elj-labs.org
DJANGO_CORS_ALLOWED_ORIGINS=https://brazcar.elj-labs.org
LOG_LEVEL=INFO

# Read by the postgres service and repeated inside DATABASE_URL.
POSTGRES_DB=brazcar
POSTGRES_USER=brazcar
POSTGRES_PASSWORD=
DATABASE_URL=postgres://brazcar:<POSTGRES_PASSWORD>@postgres:5432/brazcar

# Diagnostic SSE route (D-049). Remove the line to turn the route off.
SSE_DIAGNOSTICS_TOKEN=
# Oldest front version still served, MAJOR.MINOR.PATCH (D-105). Absent or 0.0.0: no floor.
WEB_MINIMUM_VERSION=0.0.0

# E-mail for password recovery (D-032). Unset: messages go to the container log.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
EMAIL_FROM=BrazCar <no-reply@elj-labs.org>
PASSWORD_RESET_LINK=https://brazcar.elj-labs.org/redefinir-senha?token={token}

# WhatsApp worker (D-108, D-109, D-110). Pair first: docker compose run --rm worker python manage.py pair_whatsapp
WHATSAPP_ACCOUNT=
# Where neonize keeps the session: a role of its own with its own schema (D-040), same server,
# created by infra/postgres/whatsapp-role.sql. The Go driver insists on TLS unless told otherwise.
WHATSAPP_SESSION_DSN=postgres://brazcar_wa:<WHATSAPP_DB_PASSWORD>@postgres:5432/brazcar?sslmode=disable
# Groups to read, `jid=label;jid=label`; labels are what the interface shows. Never by name.
# List them: docker compose run --rm worker python manage.py list_whatsapp_groups
WHATSAPP_GROUPS=
# `pg_cron` (this Postgres has it; install once: docker compose run --rm worker python manage.py install_purge_schedule)
# or `worker` (the worker sweeps by itself). Raw messages live this long (D-119).
IMPORT_PURGE=pg_cron
IMPORT_RAW_RETENTION_HOURS=24
# The interpreter (D-115): Ollama on the host, the model that passed the golden set, the floor of
# confidence below which an offer is refused (D-116).
OLLAMA_BASE_URL=http://host.docker.internal:11434
RIDE_PARSER_MODEL=qwen3.5:4b
IMPORT_ACCEPT_THRESHOLD=0.7
