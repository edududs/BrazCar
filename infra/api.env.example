# Copy to ~/.brazcar/api.env on the host (chmod 600). Never versioned with real values.

DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=api-brazcar.elj-labs.org
DJANGO_CORS_ALLOWED_ORIGINS=https://brazcar.elj-labs.org
LOG_LEVEL=INFO

# Read by the postgres service and repeated inside DATABASE_URL.
POSTGRES_DB=brazcar
POSTGRES_USER=brazcar
POSTGRES_PASSWORD=
DATABASE_URL=postgres://brazcar:<POSTGRES_PASSWORD>@postgres:5432/brazcar

# Diagnostic SSE route (D-049). Remove the line to turn the route off.
SSE_DIAGNOSTICS_TOKEN=
