# Copy to .env (never versioned). Read by `uv run poe serve` and by compose.yml.

# --- API ---
# 1 turns on debug, the Swagger page at /api/docs and the development secret key.
DJANGO_DEBUG=1
# Required whenever DJANGO_DEBUG is off.
DJANGO_SECRET_KEY=
# Comma-separated. Defaults to localhost when DJANGO_DEBUG is on.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- Database (D-035) ---
# Unset means SQLite in backend/db.sqlite3. To use the compose Postgres:
# DATABASE_URL=postgres://brazcar:brazcar@127.0.0.1:5432/brazcar

# --- Optional Postgres from compose.yml: docker compose --profile postgres up -d ---
POSTGRES_DB=brazcar
POSTGRES_USER=brazcar
POSTGRES_PASSWORD=brazcar
POSTGRES_PORT=5432
