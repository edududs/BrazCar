{
  "components": {
    "schemas": {
      "AccountOut": {
        "description": "The owner's own view. Nobody else's account comes out of this API.",
        "properties": {
          "can_drive": {
            "title": "Can Drive",
            "type": "boolean"
          },
          "cars": {
            "items": {
              "$ref": "#/components/schemas/CarOut"
            },
            "title": "Cars",
            "type": "array"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "phone": {
            "title": "Phone",
            "type": "string"
          },
          "terms_accepted_at": {
            "format": "date-time",
            "title": "Terms Accepted At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "phone",
          "display_name",
          "email",
          "terms_accepted_at",
          "cars",
          "can_drive"
        ],
        "title": "AccountOut",
        "type": "object"
      },
      "ActionsOut": {
        "description": "What the viewer may do. The front only draws these (ADR-0011).",
        "properties": {
          "can_cancel": {
            "title": "Can Cancel",
            "type": "boolean"
          },
          "can_change_seats": {
            "title": "Can Change Seats",
            "type": "boolean"
          },
          "can_contact": {
            "title": "Can Contact",
            "type": "boolean"
          },
          "can_edit": {
            "title": "Can Edit",
            "type": "boolean"
          },
          "can_repeat": {
            "title": "Can Repeat",
            "type": "boolean"
          },
          "delay_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Delay Until"
          }
        },
        "required": [
          "can_edit",
          "can_change_seats",
          "can_cancel",
          "can_repeat",
          "can_contact",
          "delay_until"
        ],
        "title": "ActionsOut",
        "type": "object"
      },
      "BoardQuery": {
        "description": "The board's filters, as the URL carries them.",
        "properties": {
          "day": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Day"
          },
          "max_price": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Price"
          },
          "place_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Place Id"
          },
          "with_seats": {
            "default": false,
            "title": "With Seats",
            "type": "boolean"
          }
        },
        "title": "BoardQuery",
        "type": "object"
      },
      "CarIn": {
        "properties": {
          "color": {
            "title": "Color",
            "type": "string"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "plate": {
            "title": "Plate",
            "type": "string"
          }
        },
        "required": [
          "model",
          "color",
          "plate"
        ],
        "title": "CarIn",
        "type": "object"
      },
      "CarOut": {
        "properties": {
          "color": {
            "title": "Color",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "plate": {
            "title": "Plate",
            "type": "string"
          }
        },
        "required": [
          "id",
          "model",
          "color",
          "plate"
        ],
        "title": "CarOut",
        "type": "object"
      },
      "ContactOut": {
        "properties": {
          "plate": {
            "title": "Plate",
            "type": "string"
          },
          "whatsapp_url": {
            "title": "Whatsapp Url",
            "type": "string"
          }
        },
        "required": [
          "whatsapp_url",
          "plate"
        ],
        "title": "ContactOut",
        "type": "object"
      },
      "Done": {
        "properties": {
          "ok": {
            "default": true,
            "title": "Ok",
            "type": "boolean"
          }
        },
        "title": "Done",
        "type": "object"
      },
      "EditIn": {
        "description": "Absent means unchanged.",
        "properties": {
          "departure_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Departure At"
          },
          "payment_methods": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/PaymentMethod"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payment Methods"
          },
          "price": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price"
          },
          "stops": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/StopIn"
                },
                "minItems": 2,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stops"
          }
        },
        "title": "EditIn",
        "type": "object"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthStatus",
        "type": "object"
      },
      "LoginIn": {
        "properties": {
          "password": {
            "title": "Password",
            "type": "string"
          },
          "phone": {
            "title": "Phone",
            "type": "string"
          }
        },
        "required": [
          "phone",
          "password"
        ],
        "title": "LoginIn",
        "type": "object"
      },
      "PasswordResetConfirmIn": {
        "properties": {
          "password": {
            "title": "Password",
            "type": "string"
          },
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "password"
        ],
        "title": "PasswordResetConfirmIn",
        "type": "object"
      },
      "PasswordResetIn": {
        "properties": {
          "phone": {
            "title": "Phone",
            "type": "string"
          }
        },
        "required": [
          "phone"
        ],
        "title": "PasswordResetIn",
        "type": "object"
      },
      "PaymentMethod": {
        "enum": [
          "cash",
          "pix"
        ],
        "title": "PaymentMethod",
        "type": "string"
      },
      "PlaceKind": {
        "enum": [
          "area",
          "point"
        ],
        "title": "PlaceKind",
        "type": "string"
      },
      "PlaceOut": {
        "description": "What the API promises about a place, stated apart from the entity so it changes on purpose.",
        "properties": {
          "aliases": {
            "items": {
              "type": "string"
            },
            "title": "Aliases",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/PlaceKind"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "aliases",
          "parent_id"
        ],
        "title": "PlaceOut",
        "type": "object"
      },
      "PublishIn": {
        "properties": {
          "car_id": {
            "format": "uuid",
            "title": "Car Id",
            "type": "string"
          },
          "departure_at": {
            "format": "date-time",
            "title": "Departure At",
            "type": "string"
          },
          "payment_methods": {
            "items": {
              "$ref": "#/components/schemas/PaymentMethod"
            },
            "minItems": 1,
            "title": "Payment Methods",
            "type": "array"
          },
          "price": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "default": "7.00",
            "title": "Price"
          },
          "seats_available": {
            "maximum": 8,
            "minimum": 1,
            "title": "Seats Available",
            "type": "integer"
          },
          "stops": {
            "items": {
              "$ref": "#/components/schemas/StopIn"
            },
            "minItems": 2,
            "title": "Stops",
            "type": "array"
          }
        },
        "required": [
          "car_id",
          "stops",
          "departure_at",
          "seats_available",
          "payment_methods"
        ],
        "title": "PublishIn",
        "type": "object"
      },
      "RegisterIn": {
        "properties": {
          "accepts_terms": {
            "title": "Accepts Terms",
            "type": "boolean"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "password": {
            "title": "Password",
            "type": "string"
          },
          "phone": {
            "title": "Phone",
            "type": "string"
          }
        },
        "required": [
          "phone",
          "password",
          "display_name",
          "accepts_terms"
        ],
        "title": "RegisterIn",
        "type": "object"
      },
      "RepeatIn": {
        "properties": {
          "departure_at": {
            "format": "date-time",
            "title": "Departure At",
            "type": "string"
          }
        },
        "required": [
          "departure_at"
        ],
        "title": "RepeatIn",
        "type": "object"
      },
      "ResolvedPlaceOut": {
        "properties": {
          "descendants": {
            "items": {
              "$ref": "#/components/schemas/PlaceOut"
            },
            "title": "Descendants",
            "type": "array"
          },
          "place": {
            "$ref": "#/components/schemas/PlaceOut"
          }
        },
        "required": [
          "place",
          "descendants"
        ],
        "title": "ResolvedPlaceOut",
        "type": "object"
      },
      "RevisionOut": {
        "properties": {
          "revision": {
            "title": "Revision",
            "type": "integer"
          }
        },
        "required": [
          "revision"
        ],
        "title": "RevisionOut",
        "type": "object"
      },
      "RideOut": {
        "description": "The card. Never the phone, never the plate (D-031).",
        "properties": {
          "actions": {
            "$ref": "#/components/schemas/ActionsOut"
          },
          "car_color": {
            "title": "Car Color",
            "type": "string"
          },
          "car_model": {
            "title": "Car Model",
            "type": "string"
          },
          "departure_at": {
            "format": "date-time",
            "title": "Departure At",
            "type": "string"
          },
          "driver_name": {
            "title": "Driver Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_mine": {
            "title": "Is Mine",
            "type": "boolean"
          },
          "payment_methods": {
            "items": {
              "$ref": "#/components/schemas/PaymentMethod"
            },
            "title": "Payment Methods",
            "type": "array"
          },
          "price": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Price",
            "type": "string"
          },
          "seats_available": {
            "title": "Seats Available",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/RideStatus"
          },
          "stops": {
            "items": {
              "$ref": "#/components/schemas/StopOut"
            },
            "title": "Stops",
            "type": "array"
          }
        },
        "required": [
          "id",
          "driver_name",
          "car_model",
          "car_color",
          "stops",
          "departure_at",
          "seats_available",
          "price",
          "payment_methods",
          "status",
          "actions",
          "is_mine"
        ],
        "title": "RideOut",
        "type": "object"
      },
      "RideStatus": {
        "enum": [
          "open",
          "reopened",
          "full",
          "departed",
          "cancelled"
        ],
        "title": "RideStatus",
        "type": "string"
      },
      "SeatsIn": {
        "properties": {
          "seats_available": {
            "maximum": 8,
            "minimum": 0,
            "title": "Seats Available",
            "type": "integer"
          }
        },
        "required": [
          "seats_available"
        ],
        "title": "SeatsIn",
        "type": "object"
      },
      "StopIn": {
        "description": "A place of the catalog by identifier, or free text for \"other\" (D-013). One of the two.",
        "properties": {
          "place_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Place Id"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          }
        },
        "title": "StopIn",
        "type": "object"
      },
      "StopOut": {
        "properties": {
          "label": {
            "title": "Label",
            "type": "string"
          },
          "place_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Place Id"
          }
        },
        "required": [
          "place_id",
          "label"
        ],
        "title": "StopOut",
        "type": "object"
      }
    },
    "securitySchemes": {
      "SessionAuth": {
        "in": "cookie",
        "name": "brazcar_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "",
    "title": "BrazCar API",
    "version": "0.4.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/accounts/cars": {
      "post": {
        "operationId": "add_car",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CarIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "SessionAuth": []
          }
        ],
        "summary": "Add Car",
        "tags": [
          "accounts"
        ]
      }
    },
    "/api/accounts/cars/{car_id}": {
