    "/api/places": {
      "get": {
        "description": "Places whose name or alias contains `q`, accents and case ignored. Blank lists all.",
        "operationId": "search_places",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "default": "",
              "title": "Q",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PlaceOut"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Search",
        "tags": [
          "places"
        ]
      }
    },
    "/api/places/{place_id}": {
      "get": {
        "description": "One place and everything beneath it in the hierarchy.",
        "operationId": "resolve_place",
        "parameters": [
          {
            "in": "path",
            "name": "place_id",
            "required": true,
            "schema": {
              "title": "Place Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
