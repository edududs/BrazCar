{
  "components": {
    "schemas": {
      "AccountOut": {
        "description": "The owner's own view. Nobody else's account comes out of this API.",
        "properties": {
          "can_drive": {
            "title": "Can Drive",
            "type": "boolean"
          },
          "cars": {
            "items": {
              "$ref": "#/components/schemas/CarOut"
            },
            "title": "Cars",
            "type": "array"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "phone": {
            "title": "Phone",
            "type": "string"
          },
          "terms_accepted_at": {
            "format": "date-time",
            "title": "Terms Accepted At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "phone",
          "display_name",
          "email",
          "terms_accepted_at",
          "cars",
          "can_drive"
        ],
        "title": "AccountOut",
        "type": "object"
      },
      "CarIn": {
        "properties": {
          "color": {
            "title": "Color",
            "type": "string"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "plate": {
            "title": "Plate",
            "type": "string"
          }
        },
        "required": [
          "model",
          "color",
          "plate"
        ],
        "title": "CarIn",
        "type": "object"
      },
      "CarOut": {
        "properties": {
          "color": {
            "title": "Color",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "plate": {
            "title": "Plate",
            "type": "string"
          }
        },
        "required": [
          "id",
          "model",
          "color",
          "plate"
        ],
        "title": "CarOut",
        "type": "object"
      },
      "Done": {
        "properties": {
          "ok": {
            "default": true,
            "title": "Ok",
            "type": "boolean"
          }
        },
        "title": "Done",
        "type": "object"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthStatus",
        "type": "object"
      },
      "LoginIn": {
        "properties": {
          "password": {
            "title": "Password",
            "type": "string"
          },
          "phone": {
            "title": "Phone",
            "type": "string"
          }
        },
        "required": [
          "phone",
          "password"
        ],
        "title": "LoginIn",
        "type": "object"
      },
      "PasswordResetConfirmIn": {
        "properties": {
          "password": {
            "title": "Password",
            "type": "string"
          },
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "password"
        ],
        "title": "PasswordResetConfirmIn",
        "type": "object"
      },
      "PasswordResetIn": {
        "properties": {
          "phone": {
            "title": "Phone",
            "type": "string"
          }
        },
        "required": [
          "phone"
        ],
        "title": "PasswordResetIn",
        "type": "object"
      },
      "PlaceKind": {
        "enum": [
          "area",
          "point"
        ],
        "title": "PlaceKind",
        "type": "string"
      },
      "PlaceOut": {
        "description": "What the API promises about a place, stated apart from the entity so it changes on purpose.",
        "properties": {
          "aliases": {
            "items": {
              "type": "string"
            },
            "title": "Aliases",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/PlaceKind"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "aliases",
          "parent_id"
        ],
        "title": "PlaceOut",
        "type": "object"
      },
      "RegisterIn": {
        "properties": {
          "accepts_terms": {
            "title": "Accepts Terms",
            "type": "boolean"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "password": {
            "title": "Password",
            "type": "string"
          },
          "phone": {
            "title": "Phone",
            "type": "string"
          }
        },
        "required": [
          "phone",
          "password",
          "display_name",
          "accepts_terms"
        ],
        "title": "RegisterIn",
        "type": "object"
      },
      "ResolvedPlaceOut": {
        "properties": {
          "descendants": {
            "items": {
              "$ref": "#/components/schemas/PlaceOut"
            },
            "title": "Descendants",
            "type": "array"
          },
          "place": {
            "$ref": "#/components/schemas/PlaceOut"
          }
        },
        "required": [
          "place",
          "descendants"
        ],
        "title": "ResolvedPlaceOut",
        "type": "object"
      }
    },
    "securitySchemes": {
      "SessionAuth": {
        "in": "cookie",
        "name": "brazcar_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "",
    "title": "BrazCar API",
    "version": "0.4.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/accounts/cars": {
      "post": {
        "operationId": "add_car",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CarIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "SessionAuth": []
          }
        ],
        "summary": "Add Car",
        "tags": [
          "accounts"
        ]
      }
    },
