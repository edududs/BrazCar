            "in": "path",
            "name": "car_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Car Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "SessionAuth": []
          }
        ],
        "summary": "Remove Car",
        "tags": [
          "accounts"
        ]
      }
    },
