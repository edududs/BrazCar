# Copy to web/.env.local (never versioned). Vite only reads variables prefixed with VITE_.

# Origin of the API. Leave empty in development: Vite proxies /api to the local API.
VITE_API_BASE_URL=
# Where the development proxy sends /api. Defaults to http://127.0.0.1:8000.
# BRAZCAR_DEV_API_ORIGIN=http://127.0.0.1:8000
